# Public site URL used for metadata, sitemap.xml and robots.txt.
# Set this to your real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.brightinfonet.com

# Everything below is optional. Leave a value empty and the feature stays off (nothing renders).

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave EMPTY if GA4 is configured inside Google Tag Manager, otherwise page views count twice.
NEXT_PUBLIC_GA_ID=
# (Google Tag Manager GTM-TVPFN9WW is hardcoded in src/components/GoogleTagManager.tsx, no env var.)

# Calendly booking link for the "Book a 20-min call" buttons, e.g. https://calendly.com/your-team/20min
NEXT_PUBLIC_CALENDLY_URL=

# Search Console: the content="..." value of the HTML-tag verification method.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content="..." value of the msvalidate.01 meta tag.
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, digits or dashes). Served at /indexnow.txt and used by
# scripts/indexnow-submit.mjs (owner-run after each deploy).
INDEXNOW_KEY=

# Endpoint that receives lead-magnet form posts (e.g. a form service URL). Empty = download button only.
# Also used by the contact form when CONTACT_FORM_ENDPOINT is empty.
NEXT_PUBLIC_LEAD_FORM_ENDPOINT=
# Contact form backend (server-only, preferred): an https URL of a Formspree/Getform-style form
# that accepts a JSON POST, e.g. https://formspree.io/f/xxxxxxxx. The home page form posts to
# /api/contact, which validates and forwards here. Empty (and no NEXT_PUBLIC_LEAD_FORM_ENDPOINT)
# = the form opens the visitor's email app instead (mailto + WhatsApp link).
# Rebuild after setting it (the home page decides at build time which mode to show).
# SECURITY: /api/contact is unauthenticated. It is protected only by a honeypot field and an
# in-memory per-IP rate limit (5 per 10 min, per server instance). Turn on spam filtering in the
# form service too, and publish a privacy policy before enabling it.
CONTACT_FORM_ENDPOINT=

# QA ONLY, never set in production: pretend today is this date (YYYY-MM-DD) so scheduled
# blog posts render in a local build, e.g. CONTENT_NOW=2026-12-31.
CONTENT_NOW=
