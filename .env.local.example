# Public site URL used for metadata, sitemap.xml and robots.txt.
# Set this to your real production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://www.brightinfonet.com

# Everything below is optional. Leave a value empty and the feature stays off (nothing renders).

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Calendly booking link for the "Book a 20-min call" buttons, e.g. https://calendly.com/your-team/20min
NEXT_PUBLIC_CALENDLY_URL=

# Search Console: the content="..." value of the HTML-tag verification method.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content="..." value of the msvalidate.01 meta tag.
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, digits or dashes). Served at /indexnow.txt and used by
# scripts/indexnow-submit.mjs (owner-run after each deploy).
INDEXNOW_KEY=

# Endpoint that receives lead-magnet form posts (e.g. a form service URL). Empty = download button only.
NEXT_PUBLIC_LEAD_FORM_ENDPOINT=

# QA ONLY, never set in production: pretend today is this date (YYYY-MM-DD) so scheduled
# blog posts render in a local build, e.g. CONTENT_NOW=2026-12-31.
CONTENT_NOW=
